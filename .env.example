# Database
DB_PASSWORD=cybercontrol123
DATABASE_URL=postgresql://cybercontrol_app:cybercontrol123@127.0.0.1:5434/cybercontrol

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
WA_SECRET=wa-service-secret

# Public brand / domain (drives app + api + cookie + email defaults)
BRAND_NAME=CyberControl
PUBLIC_DOMAIN=cybercontrol.fun
# Optional overrides:
# APP_ORIGIN=https://app.cybercontrol.fun
# API_ORIGIN=https://api.cybercontrol.fun
# COOKIE_DOMAIN=.cybercontrol.fun
# EMAIL_FROM=CyberControl <noreply@cybercontrol.fun>

# AI (prefer generic names; GROQ_* still accepted as aliases)
AI_API_KEY=
AI_PROVIDER=groq
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# LLM_BASE_URL=

# Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Optional services
WA_SERVICE=
PARENT_URL=
REMOVE_BG_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
