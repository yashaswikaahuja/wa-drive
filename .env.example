# Database
DB_PASSWORD=cybercontrol123
DATABASE_URL=postgresql://cybercontrol_app:cybercontrol123@127.0.0.1:5434/cybercontrol

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
WA_SECRET=wa-service-secret

# Public brand / domain (drives app + api + cookie + email defaults)
BRAND_NAME=CyberControl
PUBLIC_DOMAIN=cybercontrol.fun
# Optional overrides:
# APP_ORIGIN=https://app.cybercontrol.fun
# API_ORIGIN=https://api.cybercontrol.fun
# COOKIE_DOMAIN=.cybercontrol.fun
# EMAIL_FROM=CyberControl <noreply@cybercontrol.fun>

# AI
# Preferred: configure text + OCR keys in owner-panel (saved to workspaces.settings.ai).
# Fill/semantic-map on extension-service reads owner-panel DB first, then env fallback.
# OPENROUTER_API_KEY=  # env fallback for text fill AI
# AI_API_KEY=          # env fallback alias
# AI_PROVIDER=openrouter
# Document OCR / WhatsApp profile extraction (hub/backend; also settable in owner-panel)
# MISTRAL_API_KEY=

# Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Optional services
WA_SERVICE=
PARENT_URL=
REMOVE_BG_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
