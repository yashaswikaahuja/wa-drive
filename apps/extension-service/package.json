{
  "name": "cybercontrol-extension-service",
  "version": "1.0.0",
  "description": "Standalone API for the Chrome extension — profiles, mappings, adapters",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build:tsc": "tsc -p tsconfig.json",
    "build": "node scripts/build-dist.mjs",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('[extension-service] no package tests yet')\""
  },
  "dependencies": {
    "@cc/mapper": "workspace:*",
    "@cybercontrol/svc-ai-mapper": "workspace:*",
    "@cybercontrol/svc-fill-planner": "workspace:*",
    "@cybercontrol/svc-knowledge": "workspace:*",
    "@cybercontrol/svc-learning": "workspace:*",
    "@cybercontrol/svc-runtime": "workspace:*",
    "@cybercontrol/svc-session": "workspace:*",
    "@cybercontrol/svc-shared": "workspace:*",
    "@cybercontrol/svc-teach": "workspace:*",
    "dotenv": "^17.0.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
