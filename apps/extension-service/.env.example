# extension-service environment
# ---------------------------------
# Listening port (nginx routes /api/profiles*, /api/mappings*, /api/adapters* here)
PORT=3300

# Postgres connection — MUST be the same DB the hub uses (shared DATABASE_URL)
DATABASE_URL=postgresql://cybercontrol_app:CHANGEME@localhost:5432/cybercontrol

# JWT_SECRET — MUST match the hub's JWT_SECRET (extension-service verifies tokens issued by hub)
JWT_SECRET=CHANGEME-MATCH-HUB

# DATA_DIR — where mappings.json and adapters.json live (file-based legacy stores)
# Defaults to ./data inside the service folder. Use absolute path on production.
DATA_DIR=/opt/extension-service/data
