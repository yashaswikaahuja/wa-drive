{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "outDir": "./.tsbuild",
    "rootDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@cc/mapper/split-dob": ["./node_modules/@cc/mapper/dist/split-dob.js"],
      "@cc/mapper/mapping-relation": ["./node_modules/@cc/mapper/dist/mapping-relation.js"]
    }
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "scripts/migrate-files-to-db.ts",
    "scripts/seed-knowledge.ts"
  ],
  "exclude": ["dist", ".tsbuild", "node_modules"]
}
