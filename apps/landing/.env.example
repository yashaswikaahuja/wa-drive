# CyberControl landing page — build-time config (Vite)
# Copy to .env (gitignored) for local dev, or set in your host's env (e.g. Vercel).

# Business WhatsApp number for "Book a Hindi Demo" click-to-chat.
# Digits only, with country code, no "+". Example: 919812345678
# While UNSET, all WhatsApp CTAs gracefully fall back to the on-page lead form.
VITE_WHATSAPP_NUMBER=

# Public domain drives app/site URLs when VITE_APP_URL / VITE_SITE_URL are unset.
VITE_PUBLIC_DOMAIN=cybercontrol.fun
# Optional overrides:
# VITE_APP_URL=https://app.example.com
# VITE_SITE_URL=https://example.com
