# .env.example - Frontend Configuration

VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Local defaults:
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
