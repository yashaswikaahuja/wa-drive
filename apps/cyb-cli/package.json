{
  "name": "cybercontrol-cli",
  "version": "0.1.0",
  "description": "CyberControl operator CLI — browser login, sessions, live fill reports",
  "type": "module",
  "bin": {
    "cyb": "./bin/cyb.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-entry.mjs && node --check bin/cyb.js",
    "build:entry": "node scripts/build-entry.mjs",
    "test": "node src/report.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "cybercontrol",
    "cli",
    "autofill"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/yashaswikaahuja/wa-drive.git",
    "directory": "cyb-cli"
  }
