{
  "name": "cybercontrol-whatsapp-resolver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CyberControl WhatsApp LID resolver (thin entry). Logic in @cybercontrol/wa-resolver.",
  "main": "index.js",
  "scripts": {
    "build:entry": "node scripts/build-entry.mjs",
    "build": "pnpm --filter @cybercontrol/wa-resolver run build && node scripts/build-dist.mjs",
    "start": "node scripts/build-entry.mjs && node index.js",
    "start:dist": "node dist/index.js",
    "dev": "node scripts/build-entry.mjs && node --watch index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('[whatsapp-resolver] no package tests yet')\""
  },
  "dependencies": {
    "@cybercontrol/wa-resolver": "workspace:*",
    "express": "^4.18.2",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
