{
  "manifest_version": 3,
  "name": "CyberControl AutoFill",
  "version": "5.89",
  "description": "Auto-fill SSC/Railway/NEET forms from CyberControl student profiles",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CyberControl AutoFill",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.cybercontrol.fun/*",
        "*://*.ssc.nic.in/*",
        "*://*.ssc.gov.in/*",
        "*://*.rrbcdg.gov.in/*",
        "*://*.indianrailways.gov.in/*",
        "*://*.upsconline.nic.in/*",
        "*://*.upsc.gov.in/*",
        "*://*.nta.ac.in/*",
        "*://*.jeemain.nta.nic.in/*",
        "*://*.neet.nta.nic.in/*",
        "*://*.bseb.inter.nic.in/*",
        "*://*.cbse.nic.in/*",
        "*://*.onlinesbi.sbi/*",
        "*://*.passportindia.gov.in/*",
        "*://*.digilocker.gov.in/*",
        "*://*.umang.gov.in/*",
        "*://*.services.india.gov.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
