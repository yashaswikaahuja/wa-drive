# .env.example - Backend Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (for future PostgreSQL integration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybercontrol
DB_USER=postgres
DB_PASSWORD=password

# WhatsApp
WHATSAPP_CLIENT_ID=cybercafe_main
WHATSAPP_SESSIONS_DIR=.wwebjs_auth

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
