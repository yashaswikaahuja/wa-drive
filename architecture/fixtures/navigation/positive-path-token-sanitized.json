{
  "fixture_id": "nav-positive-path-token-sanitized",
  "description": "Public page.path is sanitized pathname; token-like segments redacted; no query",
  "kind": "privacy_example",
  "raw_location_private": "https://user:pass@portal.example.gov/apply/a1b2c3d4e5f6789012345678abcdef01/edit?session=secret#frag",
  "public_page": {
    "origin": "https://portal.example.gov",
    "path": "/apply/:redacted/edit",
    "route_key": "apply/edit"
  },
  "public_must_not_contain": [
    "session=",
    "secret",
    "user:pass",
    "a1b2c3d4e5f6789012345678abcdef01",
    "query_string",
    "#"
  ],
  "path_rules": {
    "query_stripped": true,
    "fragment_stripped": true,
    "credentials_prohibited": true,
    "field_name": "path"
  }
}
