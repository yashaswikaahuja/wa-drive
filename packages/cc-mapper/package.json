{
  "name": "@cc/mapper",
  "version": "1.0.0",
  "description": "CyberControl field mapper — fuzzy match, rule engine wiring, AI match (TypeScript)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./field-aliases": "./src/field-aliases.ts",
    "./field-ident": "./src/field-ident.ts",
    "./resolve-choice": "./src/resolve-choice.ts",
    "./decide-conditional": "./src/decide-conditional.ts",
    "./match-special-fields": "./src/match-special-fields.ts",
    "./match-profile-fields": "./src/match-profile-fields.ts",
    "./fuzzy-post-passes": "./src/fuzzy-post-passes.ts",
    "./fuzzy-match": "./src/fuzzy-match.ts",
    "./ai-match": "./src/ai-match.ts",
    "./split-dob": {
      "types": "./src/split-dob.ts",
      "node": "./dist/split-dob.js",
      "default": "./src/split-dob.ts"
    },
    "./mapping-relation": {
      "types": "./src/mapping-relation.ts",
      "node": "./dist/mapping-relation.js",
      "default": "./src/mapping-relation.ts"
    },
    "./inject": "./src/inject.ts"
  },
  "scripts": {
    "build": "node scripts/build-node.mjs && node build.mjs",
    "build:node": "node scripts/build-node.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types tests/split-dob.test.mjs && node --experimental-strip-types tests/mapping-relation.test.mjs && node --experimental-strip-types tests/mapper-capabilities.test.mjs && node --experimental-strip-types tests/fuzzy-match.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "private": true
}
