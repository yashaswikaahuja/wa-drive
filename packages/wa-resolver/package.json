{
  "name": "@cybercontrol/wa-resolver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "wwebjs LID→phone resolver + contact/DP/OTP sender",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
