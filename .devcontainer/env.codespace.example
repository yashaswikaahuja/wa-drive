# =============================================================================
# LOCAL / CODESPACE ONLY — test/local-codespace branch
# Copy to extension-service/.env (gitignored). Do NOT use production secrets.
# =============================================================================

PORT=3300

# Local Postgres (matches .devcontainer/docker-compose.yml)
DATABASE_URL=postgresql://cybercontrol_local:cybercontrol_local_dev@127.0.0.1:5432/cybercontrol_local

# Local JWT — mint tokens with: node scripts/mint-local-token.mjs
# MUST match between token mint and this service. Never use prod JWT_SECRET here.
JWT_SECRET=local-codespace-jwt-secret-not-for-prod

# Optional refresh / other secrets (local dummies)
JWT_REFRESH_SECRET=local-codespace-refresh-secret
WA_SECRET=local-codespace-wa-secret

# File stores (local folder under service)
DATA_DIR=./data

# Fill-plan request/response console trace (redacts Authorization)
DEBUG_FILL_TRACE=1

# AI optional — leave empty for local fill of known mappings only
GROQ_API_KEY=
AI_API_KEY=

# Never point these at production OAuth from this branch unless you know why
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3300/api/drive/callback
