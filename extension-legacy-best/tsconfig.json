{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "lib": ["ES2018", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["globals.d.ts", "**/*.ts"],
  "exclude": ["node_modules"]
}
